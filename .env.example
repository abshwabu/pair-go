# Pair App Backend Environment Configuration

# Server
PORT=8080
DB_PATH=pair.db

# Authentication (Opaque Bearer Tokens)
TOKEN_EXPIRY_DAYS=30
TOKEN_BYTE_LENGTH=32

# S3-Compatible Object Storage (MinIO, AWS S3, Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pair-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/pair-media

# Push Notifications (Firebase Cloud Messaging HTTP v1)
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=
